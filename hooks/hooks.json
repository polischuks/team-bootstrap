{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/delivery-marker-init.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/record-dispatch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guard-git.sh",
            "if": "Bash(git *)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/quality-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/delivery-stop-hook.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "team-bootstrap:.*|.*-reviewer|.*-verifier|.*-guardian",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/subagent-brief.sh"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "deliver|team-bootstrap",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/judge-tier.sh",
            "timeout": 60
          },
          {
            "type": "agent",
            "timeout": 60,
            "prompt": "Read specs/*/spec.md and specs/*/plan.md for the milestone this prompt names, using Read/Grep/Glob. State, as factual observations and in at most four sentences, the complexity a path-based classifier cannot see: distributed correctness (consensus, exactly-once, idempotency, split-brain), irreversible data or money movement, authentication or authorisation changes, schema migration or backfill, or a public contract other systems depend on. Name what the milestone DOES; file counts are computed separately. If no specification is on disk, say nothing at all. Do not instruct the reader and do not decide the tier \u2014 bin/judge-tier.sh records that decision separately and this observation is context, not a verdict."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-context.sh SessionStart"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-context.sh PreCompact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-context.sh PostCompact"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/check-review-batch.sh"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/record-task.sh TaskCreated"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/record-task.sh TaskCompleted"
          }
        ]
      }
    ]
  }
}
